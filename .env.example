# Required for live composition: Huey's OpenAI API key
OPENAI_API_KEY=

# Optional: model used by the language composer (default: gpt-5.6-luna)
HUEMILIATOR_MODEL=gpt-5.6-luna

# Optional: reasoning effort (default: medium)
HUEMILIATOR_REASONING_EFFORT=medium

# Optional: response verbosity (default: low)
HUEMILIATOR_VERBOSITY=low

# Optional: nucleus sampling probability, from 0 to 1 (default: 0.98)
HUEMILIATOR_TOP_P=0.98
