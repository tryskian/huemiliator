  "conditions": {
    "aesthetic_appraisal": "Express Hugh's aesthetic judgment with the assurance of settled fact. Literal colour properties remain grounded in the supplied facts.",
    "familiarity_appraisal": "Express Hugh's impression of conventional taste through apparent praise; any actual frequency claim needs separate evidence.",
    "after_compliment": "Place the continuation after a backhanded opening compliment.",
    "adjective_attachment": "Use as an adjective modifying a colour or choice, or as a predicative adjective in a grammatical clause.",
    "choice_attachment": "Apply the adjective to the choice or appraisal rather than asserting a physical colour measurement.",
    "modifier_attachment": "Attach to a compatible adjective or verdict phrase with the intended degree and natural grammar.",
    "noun_phrase_attachment": "Place the noun phrase within a grammatical appraisal or verdict.",
    "same_hex": "The canonical input hex and supplied replacement hex are equal.",
    "different_hex": "The canonical input hex and supplied replacement hex differ.",
    "same_name": "The resolved input swatch name and supplied replacement name are equal.",
    "different_name": "The resolved input swatch name and supplied replacement name differ.",
    "claims_supported": "Both ideas hold as colour facts, contextual facts, or Hugh's aesthetic judgments delivered with objective certainty.",
    "related_information": "The two ideas contribute distinct information about the same relevant topic.",
    "contrast_basis": "Identify the dimension of contrast, including approval of the input versus the asserted superiority of the replacement.",
    "explanation_basis": "Identify evidence or a rule establishing why B explains or justifies A; truth of both ideas alone is insufficient.",
    "expectation_basis": "Identify the expectation raised by A and its contextual source, together with how B holds despite it.",
    "family_neutral": "The runtime assigns the input to the neutral family.",
    "family_brown": "The runtime assigns the input to the brown family.",
    "family_red": "The runtime assigns the input to the red family.",
    "family_orange": "The runtime assigns the input to the orange family.",
    "family_yellow": "The runtime assigns the input to the yellow family.",
    "family_green": "The runtime assigns the input to the green family.",
    "family_blue": "The runtime assigns the input to the blue family.",
    "family_purple": "The runtime assigns the input to the purple family.",
    "family_pink": "The runtime assigns the input to the pink family.",
    "replacement_verdict": "Assert the supplied replacement's aesthetic merit as settled fact. Where its hex equals the input, ground any distinction in the choice or naming while preserving the identical colour."
  },
